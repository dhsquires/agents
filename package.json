{
  "name": "engram-brain",
  "version": "0.1.0",
  "description": "Engram — a local, install-anywhere, self-improving memory MCP server for coding agents. Git-versioned OKF bundles as the system of record, SQLite as the derived index.",
  "type": "module",
  "license": "MIT",
  "author": "dhsquires",
  "repository": {
    "type": "git",
    "url": "https://github.com/dhsquires/agents.git"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "bin": {
    "engram-brain": "dist/index.js",
    "engram": "dist/cli.js"
  },
  "files": [
    "dist",
    "brain",
    "interview",
    "openspec",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"import('node:fs').then(fs=>{fs.chmodSync('dist/index.js',0o755);fs.chmodSync('dist/cli.js',0o755)})\"",
    "prepare": "npm run build",
    "start": "node dist/index.js",
    "serve": "node dist/index.js",
    "engram": "node dist/cli.js",
    "test": "npm run build && node --test test/*.test.mjs",
    "doctor": "node dist/cli.js doctor"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "yaml": "^2.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0"
  }
}
