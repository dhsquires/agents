# --- Provider keys (set ONE) ---
# OpenRouter (recommended default — single key, many models)
OPENROUTER_API_KEY=sk-or-v1-...

# Or OpenAI
# OPENAI_API_KEY=sk-...

# Or Anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# Or Google
# GOOGLE_API_KEY=...

# --- Model selection ---
# Must match the provider above. LiteLLM-style model strings.
AI_MODEL=openrouter/google/gemini-2.5-flash
# AI_MODEL=gpt-4o
# AI_MODEL=anthropic/claude-3-5-sonnet-20241022
# AI_MODEL=gemini/gemini-1.5-pro

# --- Linear integration ---
# If unset, Linear skills return labeled mock data (smoke test still works
# without a Linear account). Set to a real Linear API key (Personal API key
# from linear.app/settings/api) to enable real reads and (when
# execution_mode="execute" is passed to the entry reasoner) real writes.
# LINEAR_API_KEY=lin_api_...

# --- Optional overrides ---
AGENT_NODE_ID=chief-of-staff
AGENT_NODE_PORT=8001
AGENTFIELD_HTTP_PORT=8080
